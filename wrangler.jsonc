{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camera-plot",
  "account_id": "ed8894a9cc8527be3b803f6dd918f5a4",
  "main": "worker.js",
  "compatibility_date": "2026-07-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camera-plot-db",
      "database_id": "984b2f11-3854-43e3-83e8-f65f888efa30",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
