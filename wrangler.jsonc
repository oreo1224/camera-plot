{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camera-plot",
  "main": "worker.js",
  "compatibility_date": "2026-07-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // `npx wrangler d1 create camera-plot-db` で作成後、出力された ID に置換します。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camera-plot-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
